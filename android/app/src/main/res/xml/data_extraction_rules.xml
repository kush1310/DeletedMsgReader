<?xml version="1.0" encoding="utf-8"?>
<!--
  data_extraction_rules.xml — NotiCatch
  
  Android 12+ backup and device-to-device transfer exclusion rules.
  MASVS-STORAGE-2: Prevent sensitive databases, preferences, and cache
  from being included in cloud backup or device migration transfers.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
